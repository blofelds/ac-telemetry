[Unit]
Description=AC Telemetry capture service (Assetto Corsa PS5 → Pi)
Documentation=https://github.com/blofelds/ac-telemetry
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Runtime user is non-root. Install/enable of this unit still needs sudo once.
User=pi
Group=pi
# Recommended Pi layout: clone + venv under /opt/ac-telemetry (owned by pi).
# If the tree lives elsewhere (e.g. /home/pi/git/ac-telemetry), edit
# WorkingDirectory, ExecStart, ReadWritePaths, and ProtectHome before enable.
WorkingDirectory=/opt/ac-telemetry
Environment=AC_TELEMETRY_BACKEND=v4l2
Environment=AC_TELEMETRY_PROFILE=pi2b
Environment=AC_TELEMETRY_DEVICE=/dev/video0
Environment=AC_TELEMETRY_HOST=0.0.0.0
Environment=AC_TELEMETRY_PORT=8741
# Prefer a venv on the Pi so system Python stays clean.
ExecStart=/opt/ac-telemetry/.venv/bin/ac-telemetry
Restart=on-failure
RestartSec=5
# Capture dongle needs video group access on Raspberry Pi OS.
SupplementaryGroups=video

# Keep memory modest on Pi 2B (1 GB). Soft limit; tune after measuring.
MemoryMax=256M

# Hardening (compatible with Python + V4L2 under /opt).
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
RestrictNamespaces=true
# CSV sessions, recordings, accuracy artefacts under the install tree.
ReadWritePaths=/opt/ac-telemetry
# V4L capture nodes (major 81); still needs SupplementaryGroups=video.
DevicePolicy=closed
DeviceAllow=char-video rw

[Install]
WantedBy=multi-user.target
